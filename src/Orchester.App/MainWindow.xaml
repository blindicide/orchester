<Window x:Class="Orchester.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ORCHESTER" Width="1180" Height="820" MinWidth="850" MinHeight="600">
 <Window.Resources>
  <DataTemplate x:Key="Map"><Border Width="{Binding Width}" Height="105" Background="#356895" BorderBrush="White" BorderThickness="1" Padding="3" ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}"><TextBlock Text="{Binding Label}" Foreground="White" FontSize="11" TextTrimming="CharacterEllipsis"/></Border></DataTemplate>
  <ItemsPanelTemplate x:Key="HorizontalMap"><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
 </Window.Resources>
 <Grid Margin="24"><Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Grid.Column="0" Margin="0,0,24,0"><TextBlock Text="ORCHESTER" FontSize="25" FontWeight="Bold"/><TextBlock Text="{DynamicResource Foundation}"/>
   <ListBox SelectedIndex="{Binding Section}" IsEnabled="{Binding Idle}" Background="{DynamicResource Panel}" Foreground="{DynamicResource Ink}" BorderThickness="0" Padding="8" AutomationProperties.Name="{DynamicResource Navigation}"><ListBoxItem Content="{DynamicResource Install}" Padding="8,12"/><ListBoxItem Content="{DynamicResource Manage}" Padding="8,12"/><ListBoxItem Content="{DynamicResource Disks}" Padding="8,12"/><ListBoxItem Content="{DynamicResource Recovery}" Padding="8,12"/><ListBoxItem Content="{DynamicResource Settings}" Padding="8,12"/></ListBox>
   <TextBlock Text="{Binding HostText}" Margin="0,25,0,0" FontSize="12"/>
  </StackPanel>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="8,0,8,0">
   <StackPanel Visibility="{Binding InstallVisibility}"><TextBlock Text="{Binding StageTitle}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Intro}"/>
    <StackPanel IsEnabled="{Binding Idle}">
    <StackPanel Visibility="{Binding Stage1Visibility}"><Label Content="{DynamicResource Distribution}" Target="{Binding ElementName=Distribution}"/><ComboBox x:Name="Distribution" ItemsSource="{Binding Distributions}" SelectedItem="{Binding Distribution}" AutomationProperties.Name="{DynamicResource Distribution}"/></StackPanel>
    <StackPanel Visibility="{Binding Stage2Visibility}"><Label Content="{DynamicResource Release}" Target="{Binding ElementName=Release}"/><ComboBox x:Name="Release" ItemsSource="{Binding Releases}" SelectedItem="{Binding Release}" DisplayMemberPath="Version" AutomationProperties.Name="{DynamicResource Release}"/><TextBlock Text="{DynamicResource Unvalidated}"/><TextBlock Text="{Binding DownloadUrl}"/><TextBlock Text="{Binding ChecksumUrl}"/><Label Content="{DynamicResource LocalIso}" Target="{Binding ElementName=IsoPath}"/><TextBox x:Name="IsoPath" Text="{Binding IsoPath,UpdateSourceTrigger=PropertyChanged}"/><Button Content="{DynamicResource Browse}" Command="{Binding BrowseCommand}" HorizontalAlignment="Left"/><Label Content="{DynamicResource Digest}" Target="{Binding ElementName=Digest}"/><TextBox x:Name="Digest" Text="{Binding Digest,UpdateSourceTrigger=PropertyChanged}" MaxLength="64"/><TextBlock Text="{DynamicResource DigestHelp}"/><CheckBox IsChecked="{Binding DigestTrusted}"><TextBlock Text="{DynamicResource DigestTrust}"/></CheckBox><WrapPanel><Button Content="{DynamicResource Verify}" Command="{Binding VerifyCommand}"/><Button Content="{DynamicResource Download}" Command="{Binding DownloadCommand}"/></WrapPanel></StackPanel>
    <StackPanel Visibility="{Binding Stage3Visibility}"><TextBlock Text="{DynamicResource StorageHelp}"/><Label Content="{DynamicResource TargetDisk}" Target="{Binding ElementName=Disk}"/><ComboBox x:Name="Disk" ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedDisk}" DisplayMemberPath="Label"/><Label Content="{DynamicResource SourcePartition}" Target="{Binding ElementName=Partition}"/><ComboBox x:Name="Partition" ItemsSource="{Binding Partitions}" SelectedItem="{Binding SelectedPartition}" DisplayMemberPath="Label"/><Label Content="{DynamicResource Allocation}" Target="{Binding ElementName=Size}"/><TextBox x:Name="Size" Text="{Binding SizeGiB,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{DynamicResource BitLockerHelp}"/><Button Content="{DynamicResource Refresh}" Command="{Binding RefreshCommand}" HorizontalAlignment="Left"/></StackPanel>
    <StackPanel Visibility="{Binding Stage4Visibility}"><TextBlock Text="{DynamicResource Guided}" FontSize="20"/><TextBlock Text="{DynamicResource ModeHelp}"/><TextBlock Text="{DynamicResource Preservation}"/></StackPanel>
    <StackPanel Visibility="{Binding Stage5Visibility}"><TextBlock Text="{DynamicResource ReviewWarning}" FontWeight="SemiBold"/><WrapPanel><StackPanel Margin="0,0,12,10"><TextBlock Text="{DynamicResource CurrentLayout}"/><ItemsControl ItemsSource="{Binding CurrentMap}" ItemTemplate="{StaticResource Map}" ItemsPanel="{StaticResource HorizontalMap}"/></StackPanel><StackPanel><TextBlock Text="{DynamicResource ProposedLayout}"/><ItemsControl ItemsSource="{Binding ProposedMap}" ItemTemplate="{StaticResource Map}" ItemsPanel="{StaticResource HorizontalMap}"/></StackPanel></WrapPanel><ItemsControl ItemsSource="{Binding Changes}"/><Button Content="{DynamicResource CreatePlan}" Command="{Binding PlanCommand}" HorizontalAlignment="Left"/><CheckBox IsChecked="{Binding Approved}"><TextBlock Text="{DynamicResource Approve}"/></CheckBox><Button Content="{DynamicResource SavePlan}" Command="{Binding SavePlanCommand}" HorizontalAlignment="Left"/></StackPanel>
    <StackPanel Visibility="{Binding Stage6Visibility}"><TextBlock Text="{DynamicResource DryRunSaved}" FontSize="20"/><TextBlock Text="{DynamicResource RestartBlocked}"/></StackPanel>
    <StackPanel Visibility="{Binding Stage7Visibility}"><TextBlock Text="{DynamicResource RestartBlocked}" FontSize="20"/></StackPanel>
    </StackPanel><WrapPanel Margin="0,28,0,0"><Button Content="{DynamicResource Back}" Command="{Binding BackCommand}"/><Button Content="{DynamicResource Next}" Command="{Binding NextCommand}"/></WrapPanel>
   </StackPanel>
   <StackPanel Visibility="{Binding ManageVisibility}"><TextBlock Text="{DynamicResource Manage}" FontSize="26"/><TextBlock Text="{DynamicResource ManagementHelp}"/><Button Content="{DynamicResource Inspect}" Command="{Binding InspectCommand}"/><ItemsControl ItemsSource="{Binding Operations}"/></StackPanel>
   <StackPanel Visibility="{Binding DisksVisibility}"><TextBlock Text="{DynamicResource Disks}" FontSize="26"/><Button Content="{DynamicResource Refresh}" Command="{Binding RefreshCommand}"/><TextBlock Text="{DynamicResource StorageHelp}"/><ItemsControl ItemsSource="{Binding Inventory}"/><TextBlock Text="{DynamicResource CurrentLayout}"/><ItemsControl ItemsSource="{Binding CurrentMap}" ItemTemplate="{StaticResource Map}" ItemsPanel="{StaticResource HorizontalMap}"/></StackPanel>
   <StackPanel Visibility="{Binding RecoveryVisibility}"><TextBlock Text="{DynamicResource Recovery}" FontSize="26"/><TextBlock Text="{DynamicResource RecoveryHelp}"/><WrapPanel><Button Content="{DynamicResource Inspect}" Command="{Binding InspectCommand}"/><Button Content="{DynamicResource Export}" Command="{Binding ExportCommand}"/></WrapPanel><ItemsControl ItemsSource="{Binding Operations}"/></StackPanel>
   <StackPanel Visibility="{Binding SettingsVisibility}" IsEnabled="{Binding Idle}"><TextBlock Text="{DynamicResource Settings}" FontSize="26"/><Label Content="{DynamicResource Language}" Target="{Binding ElementName=LanguagePicker}"/><ComboBox x:Name="LanguagePicker" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}"/><CheckBox Content="{DynamicResource Dark}" IsChecked="{Binding Dark}"/><Label Content="{DynamicResource DownloadDirectory}" Target="{Binding ElementName=Downloads}"/><TextBox x:Name="Downloads" Text="{Binding Settings.DownloadDirectory,UpdateSourceTrigger=PropertyChanged}"/><Label Content="{DynamicResource StagingDirectory}" Target="{Binding ElementName=Staging}"/><TextBox x:Name="Staging" Text="{Binding Settings.StagingDirectory,UpdateSourceTrigger=PropertyChanged}"/><Label Content="{DynamicResource Bandwidth}" Target="{Binding ElementName=Bandwidth}"/><TextBox x:Name="Bandwidth" Text="{Binding Settings.BandwidthMiB,UpdateSourceTrigger=PropertyChanged,ValidatesOnExceptions=True}"/><CheckBox Content="{DynamicResource Verbose}" IsChecked="{Binding Settings.Verbose}"/><CheckBox Content="{DynamicResource CheckUpdates}" IsChecked="{Binding Settings.CheckUpdates}" IsEnabled="False"/><CheckBox Content="{DynamicResource RetainImages}" IsChecked="{Binding Settings.RetainImages}"/><TextBlock Text="{DynamicResource Privacy}"/><Button Content="{DynamicResource SaveSettings}" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left"/></StackPanel>
  </Grid></ScrollViewer>
  <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource Panel}" Padding="12" Margin="0,16,0,0"><DockPanel><Button DockPanel.Dock="Right" Content="{DynamicResource Cancel}" Command="{Binding CancelCommand}"/><StackPanel><ProgressBar IsIndeterminate="{Binding Busy}" Height="3"/><TextBlock Text="{Binding Status}" AutomationProperties.LiveSetting="Polite"/></StackPanel></DockPanel></Border>
 </Grid>
</Window>
